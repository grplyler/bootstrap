#!/usr/bin/env python3
"""burnit - write a bootable image (.iso/.img) to a USB thumb drive.

Works on macOS and Linux. Pure stdlib (no pip deps).

Usage:
    burnit [IMAGE]

If IMAGE is omitted you'll be prompted for it. A pretty arrow-key menu
lets you pick the target disk. The write is destructive and confirmed
before anything is touched.

Controls in the menu: Up/Down (or j/k) to move, Enter to select, q to quit.
"""

import os
import sys
import time
import shutil
import plistlib
import subprocess

IS_MAC = sys.platform == "darwin"
IS_LINUX = sys.platform.startswith("linux")

CHUNK = 4 * 1024 * 1024  # 4 MiB


# ----- ANSI helpers --------------------------------------------------------

def c(code, s):
    if not sys.stdout.isatty():
        return s
    return f"\033[{code}m{s}\033[0m"


def bold(s):  return c("1", s)
def red(s):   return c("1;31", s)
def green(s): return c("1;32", s)
def yellow(s):return c("1;33", s)
def blue(s):  return c("1;34", s)
def dim(s):   return c("2", s)


def die(msg):
    print(red("xx ") + msg, file=sys.stderr)
    sys.exit(1)


def human(n):
    n = float(n)
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024 or unit == "TB":
            return f"{n:.1f}{unit}" if unit != "B" else f"{int(n)}{unit}"
        n /= 1024


# ----- disk enumeration ----------------------------------------------------

class Disk:
    def __init__(self, dev, size, label, removable):
        self.dev = dev            # /dev/diskN or /dev/sdX
        self.size = int(size or 0)
        self.label = label or ""
        self.removable = removable

    def menu_line(self):
        tag = green("[removable]") if self.removable else yellow("[internal] ")
        return f"{tag}  {bold(self.dev):<14}  {human(self.size):>9}  {dim(self.label)}"


def list_disks_mac():
    out = subprocess.check_output(["diskutil", "list", "-plist"])
    data = plistlib.loads(out)
    disks = []
    for dev in data.get("WholeDisks", []):
        try:
            info = plistlib.loads(
                subprocess.check_output(["diskutil", "info", "-plist", dev])
            )
        except subprocess.CalledProcessError:
            continue
        # Skip synthesized/virtual containers (APFS containers, disk images).
        if info.get("VirtualOrPhysical") == "Virtual":
            continue
        removable = bool(info.get("Removable") or info.get("RemovableMedia")
                         or info.get("Ejectable"))
        external = info.get("Internal") is False
        label = info.get("MediaName") or info.get("IORegistryEntryName") or ""
        if external:
            label = (label + " (external)").strip()
        disks.append(Disk(
            dev=f"/dev/{dev}",
            size=info.get("TotalSize") or info.get("Size") or 0,
            label=label,
            removable=removable or external,
        ))
    return disks


def list_disks_linux():
    out = subprocess.check_output(
        ["lsblk", "-J", "-b", "-d", "-o", "NAME,SIZE,MODEL,TYPE,RM,TRAN"]
    )
    import json
    data = json.loads(out)
    disks = []
    for d in data.get("blockdevices", []):
        if d.get("type") != "disk":
            continue
        name = d.get("name", "")
        if name.startswith(("loop", "ram", "zram")):
            continue
        removable = str(d.get("rm")) in ("1", "True", "true") or d.get("tran") == "usb"
        label = (d.get("model") or "").strip()
        if d.get("tran"):
            label = f"{label} ({d['tran']})".strip()
        disks.append(Disk(
            dev=f"/dev/{name}",
            size=d.get("size") or 0,
            label=label,
            removable=removable,
        ))
    return disks


def list_disks():
    if IS_MAC:
        return list_disks_mac()
    if IS_LINUX:
        return list_disks_linux()
    die(f"Unsupported platform: {sys.platform}")


# ----- pretty menu ---------------------------------------------------------

def pick_disk(disks):
    """Arrow-key curses menu. Falls back to numbered prompt."""
    if not disks:
        die("No disks found.")
    # Sort removable first so the safe choice is on top.
    disks = sorted(disks, key=lambda d: (not d.removable, d.dev))

    try:
        import curses
    except ImportError:
        return pick_disk_fallback(disks)

    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        return pick_disk_fallback(disks)

    def run(stdscr):
        curses.curs_set(0)
        curses.use_default_colors()
        idx = 0
        while True:
            stdscr.erase()
            stdscr.addstr(0, 0, "Select target USB disk  ", curses.A_BOLD)
            stdscr.addstr(1, 0, "Up/Down or j/k to move, Enter to select, q to quit")
            stdscr.addstr(2, 0, "")
            for i, d in enumerate(disks):
                # curses can't render ANSI; build a plain line.
                tag = "[removable]" if d.removable else "[internal] "
                line = f"  {tag}  {d.dev:<14}  {human(d.size):>9}  {d.label}"
                attr = curses.A_REVERSE if i == idx else curses.A_NORMAL
                try:
                    stdscr.addstr(3 + i, 0, line[:curses.COLS - 1], attr)
                except curses.error:
                    pass
            stdscr.refresh()
            ch = stdscr.getch()
            if ch in (curses.KEY_UP, ord("k")):
                idx = (idx - 1) % len(disks)
            elif ch in (curses.KEY_DOWN, ord("j")):
                idx = (idx + 1) % len(disks)
            elif ch in (curses.KEY_ENTER, 10, 13):
                return disks[idx]
            elif ch in (ord("q"), 27):
                return None

    return curses.wrapper(run)


def pick_disk_fallback(disks):
    print(bold("\nAvailable disks:"))
    for i, d in enumerate(disks):
        print(f"  {i+1:>2}) {d.menu_line()}")
    while True:
        ans = input(bold("Pick disk number (q to quit): ")).strip()
        if ans in ("q", "Q", ""):
            return None
        if ans.isdigit() and 1 <= int(ans) <= len(disks):
            return disks[int(ans) - 1]
        print(red("Invalid choice."))


# ----- write ---------------------------------------------------------------

def unmount(disk):
    if IS_MAC:
        subprocess.run(["diskutil", "unmountDisk", disk.dev], check=False)
    else:
        # Unmount every partition of the disk.
        try:
            out = subprocess.check_output(
                ["lsblk", "-ln", "-o", "NAME,MOUNTPOINT", disk.dev]
            ).decode()
            for line in out.splitlines():
                parts = line.split(None, 1)
                if len(parts) == 2 and parts[1].strip():
                    subprocess.run(["umount", f"/dev/{parts[0]}"], check=False)
        except subprocess.CalledProcessError:
            pass


def target_path(disk):
    # macOS raw device (rdiskN) is much faster for whole-disk writes.
    if IS_MAC:
        return disk.dev.replace("/dev/disk", "/dev/rdisk")
    return disk.dev


def write_image(image, disk):
    src_size = os.path.getsize(image)
    dst = target_path(disk)
    print(blue("==> ") + f"Unmounting {disk.dev}")
    unmount(disk)

    print(blue("==> ") + f"Writing {bold(image)} -> {bold(dst)}")
    written = 0
    start = time.time()
    last = 0.0
    try:
        with open(image, "rb") as fsrc, open(dst, "wb") as fdst:
            while True:
                buf = fsrc.read(CHUNK)
                if not buf:
                    break
                fdst.write(buf)
                written += len(buf)
                now = time.time()
                if now - last > 0.2 or written >= src_size:
                    progress_bar(written, src_size, now - start)
                    last = now
            print("\n" + blue("==> ") + "Flushing buffers (fsync)...")
            fdst.flush()
            os.fsync(fdst.fileno())
    except PermissionError:
        die(f"Permission denied writing {dst}. Re-run with sudo.")
    except OSError as e:
        die(f"Write failed: {e}")

    if IS_MAC:
        subprocess.run(["diskutil", "eject", disk.dev], check=False)
    else:
        subprocess.run(["sync"], check=False)
    print(green("==> ") + bold("Done. Safe to remove."))


def progress_bar(done, total, elapsed):
    width = 30
    frac = done / total if total else 1.0
    filled = int(width * frac)
    bar = "#" * filled + "-" * (width - filled)
    speed = done / elapsed if elapsed > 0 else 0
    sys.stdout.write(
        f"\r  [{bar}] {frac*100:5.1f}%  {human(done)}/{human(total)}  "
        f"{human(speed)}/s   "
    )
    sys.stdout.flush()


# ----- main ----------------------------------------------------------------

def ensure_root(image):
    if os.geteuid() == 0:
        return
    if not shutil.which("sudo"):
        die("Must run as root (sudo not found).")
    print(yellow("!! ") + "Writing to a raw disk needs root. Re-running with sudo...")
    args = [sys.executable, os.path.abspath(__file__)]
    if image:
        args.append(image)
    os.execvp("sudo", ["sudo"] + args)


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    image = args[0] if args else None

    if image and not os.path.isfile(image):
        die(f"Image not found: {image}")
    if not image:
        image = input(bold("Path to image (.iso/.img): ")).strip()
        if not image:
            die("No image given.")
        image = os.path.expanduser(image)
        if not os.path.isfile(image):
            die(f"Image not found: {image}")

    ensure_root(image)

    disk = pick_disk(list_disks())
    if disk is None:
        print("Cancelled.")
        return

    # Destructive confirmation — kept verbose and explicit on purpose.
    print()
    print(red(bold("  WARNING: this ERASES the entire disk below.")))
    print(f"    Disk:  {bold(disk.dev)}  {human(disk.size)}  {disk.label}")
    print(f"    Image: {bold(image)}  ({human(os.path.getsize(image))})")
    if disk.size and os.path.getsize(image) > disk.size:
        die("Image is larger than the target disk.")
    if not disk.removable:
        print(red("    This disk is NOT marked removable — double-check it is the USB!"))
    ans = input(red("  Type 'yes' to proceed: ")).strip()
    if ans != "yes":
        print("Aborted.")
        return

    write_image(image, disk)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nInterrupted.")
        sys.exit(130)
